# ===========================================
# NutriMed AI - Environment Configuration
# ===========================================
# Copy this file to .env and update values for your environment.
# NEVER commit the .env file to version control.

# --- Application ---
APP_NAME=NutriMed AI
DEBUG=true

# --- MongoDB ---
# Development only: docker-compose.prod.yml builds MONGO_URI from
# MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD (Production section below).
MONGO_URI=mongodb://admin:nutrimed_secret@mongo:27017/nutrimed?authSource=admin
MONGO_DB_NAME=nutrimed

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://nutrimed:nutrimed_secret@rabbitmq:5672//

# --- JWT Authentication ---
# Placeholders below. With DEBUG=false the API refuses to start until JWT_SECRET
# and AES_KEY are replaced by distinct values of 32+ characters, generated with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# --- Encryption ---
# Encrypts uploaded reports. Keep it stable once set: changing it makes
# existing uploads unreadable.
AES_KEY=your-32-byte-aes-encryption-key!!

# --- Language model ---
# "ollama" (default) uses the Ollama server below. "openai" uses any
# OpenAI-compatible API instead; for Groq (key from console.groq.com):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
# Only de-identified data is sent; see app/services/llm_client.py.
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Ollama (when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://ollama:11434
# Must match a model pulled by infrastructure/scripts/init-ollama.sh.
# If this names a model Ollama does not have, every plan silently falls back
# to the deterministic templates. /health/ready reports this as degraded.
OLLAMA_MODEL=mistral:7b
# Seconds. A 7B model on CPU needs several minutes for the longer prompts.
LLM_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

# --- Microservice URLs ---
OCR_SERVICE_URL=http://ocr-service:8001
LLM_SERVICE_URL=http://llm-service:8002
NUTRITION_SERVICE_URL=http://nutrition-service:8003
FITNESS_SERVICE_URL=http://fitness-service:8004
PDF_SERVICE_URL=http://pdf-service:8005
RAG_SERVICE_URL=http://rag-service:8006

# --- CORS ---
# A JSON list: pydantic-settings parses list values as JSON, and a plain
# comma-separated value stops the API from starting.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]
# Optional pattern for further origins, e.g. Vercel preview deployments:
# ALLOWED_ORIGIN_REGEX=^https://nutrimed-[a-z0-9-]+-your-team\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# --- Visitor address (rate limiting, audit log) ---
# Leave empty behind this project's nginx. Behind a hosting proxy, the header
# it sets with the visitor's address (render.yaml uses CF-Connecting-IP),
# read CLIENT_IP_HOPS entries from the right. See docs/DEPLOY_RENDER_VERCEL.md.
CLIENT_IP_HEADER=
CLIENT_IP_HOPS=1

# --- Accounts & email ---
# Public URL of the web app, used in password-reset links. A request from one
# of ALLOWED_ORIGINS gets a link back to that origin instead.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRY_MINUTES=30
# Without SMTP_HOST no email is sent. With DEBUG=true the message (including
# any reset link) is written to the API log instead -- local development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NutriMed AI <no-reply@example.com>
SMTP_USE_TLS=true

# --- Data retention ---
# Request audit logs expire after this many days (MongoDB TTL index).
AUDIT_LOG_RETENTION_DAYS=365

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Production (docker-compose.prod.yml) ---
# See docs/DEPLOYMENT.md. Set DEBUG=false above (the prod file forces it off).
# Public hostname, without https:// -- also used for the TLS certificate path.
DOMAIN=nutrimed.example.com
# MongoDB root user, created on the first start of an empty database. Use
# URL-safe passwords, e.g.: python -c "import secrets; print(secrets.token_urlsafe(24))"
MONGO_ROOT_USERNAME=nutrimed
MONGO_ROOT_PASSWORD=
# Optional: images to run (the CD workflow sets IMAGE_TAG to the commit SHA).
# IMAGE_PREFIX=ghcr.io/bganesh909/nutrimed
# IMAGE_TAG=latest
# Optional: certificate and ACME webroot locations on the host.
# LETSENCRYPT_DIR=/etc/letsencrypt
# CERTBOT_WEBROOT=/var/www/certbot
